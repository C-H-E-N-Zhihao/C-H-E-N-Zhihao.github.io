{% comment %}
  Unified projects entry renderer for both formats
{% endcomment %}

<ul class="card-text font-weight-light list-group list-group-flush">
  {% for entry in include.entries %}
    <li class="list-group-item">
      {% if entry.url %}
        <h6 class="title font-weight-bold">
          <a href="{{ entry.url }}" target="_blank">{{ entry.name }}</a>
        </h6>
      {% else %}
        <h6 class="title font-weight-bold">{{ entry.name }}</h6>
      {% endif %}

      {% if entry.highlights %}
        <div class="project-awards">
          {% for item in entry.highlights %}
            <p class="mb-2 font-weight-bold text-primary">
              <i class="fa-solid fa-award text-warning mr-1" aria-hidden="true"></i>
              {{ item | markdownify | remove: '<p>' | remove: '</p>' }}
            </p>
          {% endfor %}
        </div>
      {% endif %}

      {% if entry.summary %}
        <p class="mb-0">{{ entry.summary | markdownify | remove: '<p>' | remove: '</p>' }}</p>
      {% endif %}
    </li>
  {% endfor %}
</ul>
